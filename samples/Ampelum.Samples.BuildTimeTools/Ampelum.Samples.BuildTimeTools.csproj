<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Ampelum.Samples.BuildTimeTools</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ampelum\Ampelum.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Analyzer items are not inherited from a referenced project, so the sample lists them itself. -->
    <ProjectReference Include="..\..\src\Ampelum.SourceGenerator\Ampelum.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Ampelum.Analyzers\Ampelum.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
