<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- v0.7 PSQ-1: PublicApiAnalyzer NoWarn is set in Directory.Build.targets,
       which loads AFTER each csproj so EnablePublicApiAnalyzer is observable. -->
  <!-- Per-project IsPackable is set explicitly in each csproj.
       Shared NuGet metadata (Version, Authors, License, etc.) lives in Directory.Build.targets,
       which is evaluated AFTER each csproj sets IsPackable so the packable-only branch fires correctly. -->
</Project>
