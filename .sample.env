# Copy this file to .env and fill in the values you need. Never commit .env.
# The samples also read appsettings.json with the same key names, and real
# environment variables override both. The library itself reads only real
# environment variables. Nothing here has a default in the code.

# Required for the use case samples when run without --fake.
# Your OpenRouter API key.
OPENROUTER_API_KEY=
# Model id used for normal calls.
OPENROUTER_MODEL_1=

# Model id used by tests, by the bulk documents and chat frontend samples as the
# fallback model, and by the agent runtime sample for its fast tier. Required by those
# samples when run without --fake; none falls back to OPENROUTER_MODEL_1.
OPENROUTER_MODEL_2=

# Optional. Only if you run models locally with LM Studio.
# Chat endpoint URL.
LMSTUDIO_URL=
# Model id loaded in LM Studio.
LMSTUDIO_MODEL=

# Optional. Only if you run models locally with Ollama.
# Server URL. The name really does end in "in".
OLLAMA_URLin=
# Model tag.
OLLAMA_MODEL=

# Optional. Only for live provider tests.
# OpenRouter key that turns those tests on.
AMPELUM_INTEGRATION_OPENROUTER_KEY=

# Optional. Only for the Postgres tests in Ampelum.Agent.Tests and in the expense
# approval sample tests; CI leaves them out. Real environment variable, not read from
# this file by the tests. Connection string of an isolated database. Those tests fail
# when it is empty.
AMPELUM_TEST_POSTGRES=

# Required only by the expense approval sample when run with --postgres.
# Connection string of an isolated PostgreSQL database. The run fails when it is empty.
WORKFLOW_POSTGRES=

# Required only for the bulk documents sample when run without --fake.
# Anthropic API key used for the message batches endpoints.
ANTHROPIC_API_KEY=
# Anthropic model id sent with the whole batch.
ANTHROPIC_MODEL=

# Required only by the research assistant sample when run without --fake.
# Brave Search API key (subscription token) for the web_search tool.
BRAVE_API_KEY=

# Required only by the traced pipeline sample when run without --fake.
# LangFuse public key, secret key and base URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENDPOINT=
# LangSmith API key, project name and base URL.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
# Phoenix OTLP endpoint URL.
PHOENIX_ENDPOINT=
# Optional. Phoenix API key, sent only when set.
PHOENIX_API_KEY=

# Required only by the vector store swap sample when run without --fake.
# Store to use: pgvector, pinecone, qdrant or inmemory.
VECTOR_STORE=
# Vector size. Must match what the embedding model returns.
VECTOR_DIMENSION=
# Any OpenAI-compatible embeddings endpoint, its key and its model id.
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Only when VECTOR_STORE=pgvector. Connection string of a database with the vector extension.
PGVECTOR_CONNECTION_STRING=
# Only when VECTOR_STORE=pinecone. The index must already exist.
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=
# Only when VECTOR_STORE=qdrant. Host, gRPC port and collection name.
QDRANT_HOST=
QDRANT_PORT=
QDRANT_COLLECTION=

# Required only by the safety gateway sample when run without --fake.
# OpenAI-compatible moderation endpoint and its key.
MODERATION_ENDPOINT=
MODERATION_API_KEY=
# Price per token in your currency, for the cost estimate. Decimal or exponent form.
MODEL_INPUT_RATE=
MODEL_OUTPUT_RATE=

# Required only by the document review sample when run without --fake.
# Each is read only by the part that uses it.
# Reranker to use: cohere or voyage.
REVIEW_RERANKER=
# API key of the chosen reranker.
REVIEW_RERANKER_KEY=
# Model id sent to the chosen reranker.
REVIEW_RERANKER_MODEL=
# Base URL of the remote reviewer agent (http or https).
REVIEW_A2A_URL=
# Batch API key.
REVIEW_BATCH_KEY=
# Model id sent with the whole batch.
REVIEW_BATCH_MODEL=
