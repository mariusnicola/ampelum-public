# Copy this file to .env and fill in the values you need. Never commit .env.
# The samples also read appsettings.json with the same key names, and real
# environment variables override both. The library itself reads only real
# environment variables. Nothing here has a default in the code.

# Required for the use case samples when run without --fake.
# Your OpenRouter API key.
OPENROUTER_API_KEY=
# Model id used for normal calls.
OPENROUTER_MODEL_1=

# Optional. Model id used by tests. Falls back to OPENROUTER_MODEL_1.
OPENROUTER_MODEL_2=

# Optional. Only if you run models locally with LM Studio.
# Chat endpoint URL.
LMSTUDIO_URL=
# Model id loaded in LM Studio.
LMSTUDIO_MODEL=

# Optional. Only if you run models locally with Ollama.
# Server URL. The name really does end in "in".
OLLAMA_URLin=
# Model tag.
OLLAMA_MODEL=

# Optional. Only for live provider tests.
# OpenRouter key that turns those tests on.
AMPELUM_INTEGRATION_OPENROUTER_KEY=

# Optional. Only for the three Postgres tests in Ampelum.Agent.Tests.
# Connection string of an isolated database. Those tests fail when it is empty.
AMPELUM_TEST_POSTGRES=
