<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>SignalGrid.Ampelum.Retrieval.Reranking</AssemblyName>
    <PackageId>SignalGrid.Ampelum.Retrieval.Reranking</PackageId>
    <Description>ONNX-backed cross-encoder rerankers for Ampelum.</Description>
    <PackageTags>ampelum;llm;ai;rerank;cross-encoder;onnx</PackageTags>
    <NoWarn>$(NoWarn);AMPELUM_V09_PREVIEW</NoWarn>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ampelum\Ampelum.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ampelum.Retrieval.Reranking.Tests" />
  </ItemGroup>
</Project>
