<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SignalGrid.Ampelum.Testing</PackageId>
    <AssemblyName>SignalGrid.Ampelum.Testing</AssemblyName>
    <Description>Test helpers for Ampelum programs — FakeChatClient and signature assertions.</Description>
    <PackageTags>testing;test-doubles;fakes;ampelum</PackageTags>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ampelum\Ampelum.csproj" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
