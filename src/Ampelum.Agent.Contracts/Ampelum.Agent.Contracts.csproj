<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SignalGrid.Ampelum.Agent.Contracts</PackageId>
    <Version>0.8.0-rc3</Version>
    <Description>Dependency-free declarative workflow and governance contracts for SignalGrid.Ampelum agents.</Description>
    <PackageTags>signalgrid;ampelum;agents;workflows;governance;contracts</PackageTags>
    <RootNamespace>SignalGrid.Ampelum.Agent.Contracts</RootNamespace>
    <AssemblyName>SignalGrid.Ampelum.Agent.Contracts</AssemblyName>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
