<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>SignalGrid.Ampelum</AssemblyName>
    <PackageId>SignalGrid.Ampelum</PackageId>
    <!-- Version inherited from Directory.Build.targets (0.8.0-rc1 — see comment there). -->
    <Description>Declarative LM programming for .NET, on top of Microsoft.Extensions.AI.</Description>
    <PackageTags>ampelum;llm;ai;openai;anthropic;meai</PackageTags>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Polly" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ampelum.SourceGenerator\Ampelum.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ampelum.Tests" />
    <InternalsVisibleTo Include="SignalGrid.Ampelum.Testing" />
    <InternalsVisibleTo Include="Ampelum.Testing.Tests" />
    <InternalsVisibleTo Include="Ampelum.ContractTests" />
    <InternalsVisibleTo Include="Ampelum.Benchmarks" />
    <InternalsVisibleTo Include="SignalGrid.Ampelum.Retrieval" />
    <InternalsVisibleTo Include="SignalGrid.Ampelum.Persistence.Sqlite" />
  </ItemGroup>
</Project>
